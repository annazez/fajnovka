{
  "name": "fajnovka",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Pitch deck and manual for Fajnovka, a proposed public transport loyalty programme for Ostrava (MSIC LabZero 2026).",
  "license": "EUPL-1.2",
  "repository": "github:annazez/fajnovka",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build --force",
    "build:test": "astro build --force --mode test",
    "preview": "astro preview",
    "format": "prettier --write .",
    "check": "npm run check:format && npm run check:types && npm run check:code && npm run check:styles && npm run check:text && npm run check:licences",
    "check:format": "prettier --check .",
    "check:types": "astro check",
    "check:code": "eslint .",
    "check:styles": "stylelint \"src/**/*.{css,astro}\"",
    "check:text": "node scripts/ste.ts",
    "check:licences": "node scripts/licences.ts",
    "manual:pdf": "node scripts/manual-pdf.ts",
    "test:unit": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:lighthouse": "node scripts/lighthouse.ts"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.10",
    "@fontsource-variable/montserrat": "^5.3.0",
    "astro": "^7.4.12"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "ajv": "^8.20.0",
    "chrome-launcher": "^1.2.3",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.14.0",
    "lighthouse": "^13.6.0",
    "pdfjs-dist": "^6.5.438",
    "postcss-html": "^2.0.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "satteri": "^0.11.7",
    "stylelint": "^18.0.0",
    "stylelint-config-html": "^2.0.0",
    "stylelint-config-standard": "^41.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.8"
    }
  }
}
