---
import Manual from '../../components/Manual.astro';
import { manualMd } from '../../data/manual.ts';
import { useDictionary } from '../../i18n/index.ts';
import Base from '../../layouts/Base.astro';
import { manualJsonLd } from '../../lib/agents.ts';

const { manual } = useDictionary('en');
---

<Base
  locale="en"
  title={`Fajnovka · ${manual.title}`}
  description={manual.description}
  path="/manual/"
  data={manualJsonLd('en')}
  markdown={manualMd('en')}
>
  <Manual />
</Base>
