---
/**
 * The title of a slide: a sentence that gives the point. Each item of `lines` starts on a new line.
 * The last line gets the accent bar.
 */
interface Props {
  id: string;
  lines: readonly string[];
}

const { id, lines } = Astro.props;
const last = lines.length - 1;
---

<h2 class="t-title" id={id} data-in="0">
  {lines.map((line, index) => (
    <>
      {index > 0 && <br />}
      {index === last ? <span class="mark">{line}</span> : line}
    </>
  ))}
</h2>
