---
import Headline from '../components/Headline.astro';
import Slide from '../components/Slide.astro';
import { numbers } from '../data/numbers.ts';
import { useDictionary } from '../i18n/index.ts';
import { toLocale } from '../i18n/locales.ts';
import { formatNumber, percentSign } from '../lib/format.ts';

const locale = toLocale(Astro.currentLocale);
const t = useDictionary(locale).paradox;

// A vehicle with 100 places: the taken ones spread like passengers who sit apart.
const SEATS = 100;
const taken = new Set([6, 13, 27, 35, 42, 48, 54, 63, 69, 81, 88, 96]);
if (taken.size !== numbers.peakOccupancy.value) {
  throw new Error('The seat plan must show as many taken seats as the occupancy percentage.');
}

// People who live around a stop: points inside the five-minute circle, on a 100 × 100 grid.
const people = [
  [50, 16],
  [72, 24],
  [29, 27],
  [82, 46],
  [18, 50],
  [68, 62],
  [33, 70],
  [53, 82],
  [77, 76],
  [22, 34],
  [61, 38],
  [40, 46],
];
---

<Slide id="paradox" theme="white" notes={t.notes} {...Astro.props}>
  <Headline id="paradox-title" lines={t.title} />

  <div class="paradox__stats">
    <figure data-in="3">
      <div class="paradox__number">
        <p class="t-hero" data-count={numbers.residentsNearStop.value}>{formatNumber(numbers.residentsNearStop.value, locale)}</p>
        <svg class="paradox__walk" viewBox="0 0 100 100" aria-hidden="true">
          <circle class="paradox__reach" cx="50" cy="50" r="46"></circle>
          {people.map(([x, y]) => <circle class="paradox__person" cx={x} cy={y} r="3.4" />)}
          <circle class="paradox__stop" cx="50" cy="50" r="7.5"></circle>
        </svg>
      </div>
      <figcaption class="t-body">{t.residents}</figcaption>
    </figure>

    <figure data-in="6">
      <div class="paradox__number">
        <p class="t-hero">
          <span data-count={numbers.peakOccupancy.value}>{numbers.peakOccupancy.value}</span>{percentSign(locale)}
        </p>
        <div class="paradox__seats" aria-hidden="true">
          {Array.from({ length: SEATS }, (_, seat) => <i class:list={{ taken: taken.has(seat) }} />)}
        </div>
      </div>
      <figcaption class="t-body">{t.occupancy}</figcaption>
    </figure>
  </div>

  <p class="slide__source t-small" data-in="8">{t.source}</p>
</Slide>

<style>
  @import '../styles/media.css';

  .paradox__stats {
    display: grid;
    grid-template-columns: auto auto;
    gap: 7rem;
    justify-content: space-between;
    margin-top: auto;
  }

  .paradox__number {
    display: flex;
    gap: 3.6rem;
    align-items: flex-end;
  }

  .paradox .t-hero {
    font-size: 18rem;
  }

  figcaption {
    margin-top: 2.6rem;
    white-space: nowrap;
  }

  .paradox__walk,
  .paradox__seats {
    flex: none;
    width: 14.1rem;
    height: 14.1rem;
    margin-bottom: 1.2rem;
  }

  .paradox__reach {
    fill: none;
    stroke: var(--soft);
    stroke-width: 3;
  }

  .paradox__person {
    fill: var(--fg);
  }

  .paradox__stop {
    fill: var(--accent);
    stroke: var(--fg);
    stroke-width: 4;
  }

  .paradox__seats {
    display: grid;
    grid-template-columns: repeat(10, 1fr);
    gap: 0.4rem;
  }

  .paradox__seats i {
    border-radius: 0.25rem;
    background: var(--soft);
  }

  .paradox__seats .taken {
    background: var(--fg);
  }

  /* The small pictures appear after their number has started to count. */
  :global(.deck.is-live) .paradox__walk,
  :global(.deck.is-live) .paradox__seats {
    opacity: 0;
    transform: scale(0.8);
  }

  :global(.deck.is-live) .paradox.is-active .paradox__walk,
  :global(.deck.is-live) .paradox.is-active .paradox__seats {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.6s var(--ease) 1.6s,
      transform 0.8s var(--spring) 1.6s;
  }

  @media (--flow) {
    .paradox__stats {
      grid-template-columns: 1fr;
      gap: 9rem;
      margin-top: 0;
    }

    .paradox .t-hero {
      font-size: 15rem;
    }

    .paradox__number {
      justify-content: space-between;
    }

    figcaption {
      margin-top: 2rem;
      white-space: normal;
    }
  }
</style>
