---
import Slide from '../components/Slide.astro';
import { cs, numbers } from '../data/numbers';

// 100 seats in a 10 × 10 plan; the taken ones are scattered like people in a vehicle.
const taken = new Set([4, 13, 21, 27, 36, 42, 55, 58, 63, 79, 81, 96]);
const seats = Array.from({ length: 100 }, (_, seat) => taken.has(seat));

if (taken.size !== numbers.peakOccupancyPercent) {
  throw new Error('The seat plan must show as many taken seats as the occupancy percentage.');
}
---

<Slide
  theme="white"
  class="paradox"
  notes="Skoro 259 tisíc Ostravanů bydlí do pěti minut od zastávky. V páteční špičce přitom byly vozy využité z dvanácti procent. Zastávka je blízko, místo ve voze je. Přesto vítězí auto: Ostrava dnes vozí o patnáct milionů cestujících ročně méně než v roce 2010."
>
  <h2 class="t-title" data-in>
    Zastávka je blízko.<br />Místo ve voze je.<br /><span class="mark">Přesto vítězí auto.</span>
  </h2>

  <div class="paradox__stats">
    <figure data-in style="--i:3">
      <p class="t-hero" data-count={numbers.residentsNearStop}>{cs(numbers.residentsNearStop)}</p>
      <figcaption class="t-body">lidí bydlí do 5&nbsp;minut od zastávky</figcaption>
    </figure>

    <figure data-in style="--i:6">
      <div class="paradox__load">
        <p class="t-hero"><span data-count={numbers.peakOccupancyPercent}>{numbers.peakOccupancyPercent}</span>&nbsp;%</p>
        <div class="paradox__seats" aria-hidden="true">
          {seats.map((isTaken) => <i class:list={{ taken: isTaken }} />)}
        </div>
      </div>
      <figcaption class="t-body">míst obsazeno v&nbsp;páteční špičce</figcaption>
    </figure>
  </div>

  <p class="slide__foot t-small">MAPPA · API DPO, pátek 13.&nbsp;11.&nbsp;2026, 16:38, jeden snímek</p>
</Slide>

<style>
  .paradox__stats {
    display: grid;
    grid-template-columns: 94rem 1fr;
    gap: 6rem;
    margin-top: auto;
  }

  .paradox__load {
    display: flex;
    gap: 4rem;
    align-items: flex-end;
  }

  figcaption {
    margin-top: 2.6rem;
  }

  .paradox__seats {
    display: grid;
    grid-template-columns: repeat(10, 1.05rem);
    gap: 0.4rem;
    margin-bottom: 1.4rem;
  }

  .paradox__seats i {
    height: 1.05rem;
    border-radius: 0.25rem;
    background: var(--soft);
  }

  .paradox__seats .taken {
    background: var(--fg);
    transform: scale(0);
  }

  .paradox.is-active .paradox__seats .taken {
    transform: none;
    transition: transform 0.6s var(--spring) 1.9s;
  }
</style>
