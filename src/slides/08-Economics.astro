---
import Bar from '../components/Bar.astro';
import Headline from '../components/Headline.astro';
import Slide from '../components/Slide.astro';
import { numbers } from '../data/numbers.ts';
import { useDictionary } from '../i18n/index.ts';
import { toLocale } from '../i18n/locales.ts';
import { format, percentSign } from '../lib/format.ts';

const locale = toLocale(Astro.currentLocale);
const t = useDictionary(locale).economics;

// Bars: 1 unit = 0.1rem. The longest bar has the full length, the shortest one is a dot.
const BAR = { length: 460, height: 28 };
const costs = [
  { label: t.rows.return, value: numbers.costReturn.value },
  { label: t.rows.keep, value: numbers.costKeep.value },
  { label: t.rows.acquire, value: numbers.costAcquire.value },
];
const highest = Math.max(...costs.map(({ value }) => value));

// The model ends in the year of the worse scenario, so that scenario shows the year with a plus sign.
const scenarios = [
  { id: 'worse', label: t.scenarios.worse, year: `${numbers.paybackWorse.value}+` },
  { id: 'base', label: t.scenarios.base, year: String(numbers.paybackBase.value) },
  { id: 'better', label: t.scenarios.better, year: String(numbers.paybackBetter.value) },
];
---

<Slide id="economics" theme="white" notes={t.notes} {...Astro.props}>
  <Headline id="economics-title" lines={t.title} />

  <div class="economics__facts">
    <figure data-in="3">
      <p class="t-hero">
        <span data-count={numbers.compensationShare.value} data-digits="2">
          {format(numbers.compensationShare.value, 'number', locale)}
        </span>
        {percentSign(locale)}
      </p>
      <figcaption class="t-body">{t.share}</figcaption>
    </figure>

    <div class="economics__chart" data-in="6">
      <p class="t-body" id="economics-chart">
        <strong>{t.chart}</strong>
      </p>
      <dl class="t-body" aria-labelledby="economics-chart">
        {costs.map(({ label, value }) => (
          <div>
            <dt>{label}</dt>
            <dd>
              <Bar length={Math.max(Math.round((value / highest) * BAR.length), BAR.height)} height={BAR.height} />
              <strong>{format(value, 'czk', locale)}</strong>
            </dd>
          </div>
        ))}
      </dl>
    </div>

    <figure class="economics__payback" data-scenario="base" data-in="9">
      <p class="t-hero">
        {scenarios.map(({ id, year }) => (
          <span data-year={id}>{year}</span>
        ))}
      </p>
      <figcaption class="t-body">{t.payback}</figcaption>
      <div class="economics__switch t-small" role="group" aria-label={t.scenario}>
        {scenarios.map(({ id, label }) => (
          <button type="button" data-choose={id} aria-pressed={id === 'base' ? 'true' : 'false'}>
            {label}
          </button>
        ))}
      </div>
    </figure>
  </div>

  <p class="slide__source t-small" data-in="11">
    {t.source}
  </p>
</Slide>

<script>
  import '../scripts/scenes/economics.ts';
</script>

<style>
  @import '../styles/media.css';

  .economics__facts {
    display: grid;
    grid-template-columns: 44rem 66rem 1fr;
    gap: 7rem;
    align-items: start;
    margin: auto 0 9rem;
  }

  .economics .t-hero {
    font-size: 13rem;
  }

  figcaption {
    margin-top: 2.6rem;
  }

  /* Chart: the unit is the heading, each row is a label, a bar and its value. */
  .economics__chart > p {
    white-space: nowrap;
  }

  .economics__chart dl {
    display: grid;
    gap: 2.6rem;
    margin-top: 3.4rem;
  }

  .economics__chart dd {
    display: flex;
    gap: 2.4rem;
    align-items: center;
    margin-top: 0.8rem;
  }

  .economics__chart :global(.bar) {
    height: 2.8rem;
    transform-origin: left;
  }

  .economics__chart strong {
    white-space: nowrap;
  }

  :global(.deck.is-live) .economics__chart :global(.bar) {
    transform: scaleX(0);
  }

  :global(.deck.is-live) .economics.is-active .economics__chart :global(.bar) {
    transform: none;
    transition: transform 1.2s var(--ease) 1.2s;
  }

  /* Payback: one year is visible, the scenario decides which one. */
  .economics__payback [data-year] {
    display: none;
  }

  .economics__payback[data-scenario='worse'] [data-year='worse'],
  .economics__payback[data-scenario='base'] [data-year='base'],
  .economics__payback[data-scenario='better'] [data-year='better'] {
    display: inline;
  }

  .economics__switch {
    display: inline-flex;
    margin-top: 3rem;
    padding: 0.5rem;
    border-radius: 10rem;
    background: var(--fg);
  }

  .economics__switch button {
    min-width: max(2.4rem, 24px);
    min-height: max(4.4rem, 24px);
    padding: 0 2.2rem;
    border-radius: 10rem;
    color: var(--bg);
  }

  .economics__switch button[aria-pressed='true'] {
    background: var(--bg);
    color: var(--fg);
  }

  .economics__switch button:focus-visible {
    outline-offset: 0.9rem;
  }

  @media (--flow) {
    .economics__facts {
      grid-template-columns: 1fr;
      gap: 9rem;
      margin: 0;
    }

    .economics .t-hero {
      font-size: 15rem;
    }

    .economics__chart :global(.bar) {
      height: 3.4rem;
    }

    .economics__switch button {
      min-height: max(8rem, 44px);
      padding: 0 3.4rem;
    }
  }
</style>
