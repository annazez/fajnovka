---
import SceneLines from '../components/SceneLines.astro';
import Slide from '../components/Slide.astro';
import UiIcon from '../components/UiIcon.astro';
import Wordmark from '../components/Wordmark.astro';
import { manualPdf } from '../data/manual.ts';
import { useDictionary } from '../i18n/index.ts';
import { languageName, localePath, locales, toLocale } from '../i18n/locales.ts';
import { hasPublicFile } from '../lib/site.ts';

const locale = toLocale(Astro.currentLocale);
const t = useDictionary(locale);
const layouts = ['stage', 'flow'] as const;

// The button shows only when the manual exists, so the page never has a dead link.
const manual = manualPdf(locale);
const hasManual = hasPublicFile(manual);
---

<Slide id="title" theme="cyan" notes={t.title.notes} {...Astro.props}>
  {
    layouts.map((layout) => (
      <div class="scene" data-scene={layout} aria-hidden="true">
        <SceneLines layout={layout} />
      </div>
    ))
  }

  <nav class="title__languages t-small" aria-label={t.ui.language}>
    {
      locales.map((code) => (
        <a
          href={localePath(code)}
          hreflang={code}
          lang={code}
          aria-label={`${code.toUpperCase()} · ${languageName[code]}`}
          aria-current={code === locale ? 'true' : undefined}
        >
          {code.toUpperCase()}
        </a>
      ))
    }
  </nav>

  <h1 class="title__mark" id="title-title" data-in="0">
    <span class="sr-only">Fajnovka</span>
    <Wordmark />
  </h1>
  <p class="title__slogan t-title" data-in="2">{t.title.slogan}</p>
  {
    hasManual && (
      <p data-in="4">
        <a class="title__manual t-body" href={manual}>
          <UiIcon name="book" />
          {t.title.manual}
        </a>
      </p>
    )
  }
</Slide>

<script>
  import '../scripts/scenes/title.ts';
</script>

<style>
  @import '../styles/media.css';

  .title {
    padding-top: 15rem;
  }

  .title__slogan {
    margin-top: 5.5rem;
  }

  .title__manual {
    display: inline-flex;
    gap: 1.6rem;
    align-items: center;
    margin-top: 5.5rem;
    padding: 1.8rem 3.8rem 1.8rem 3rem;
    border-radius: 10rem;
    background: var(--fg);
    color: var(--accent);
    text-decoration: none;
    transition: transform 0.4s var(--spring);
  }

  .title__manual:focus-visible,
  .title__languages a:focus-visible {
    outline-offset: 0.4rem;
  }

  @media (--hover) {
    .title__manual:hover {
      transform: scale(1.05);
    }
  }

  .title__manual :global(svg) {
    width: 4rem;
    height: 4rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Language switch: one colour, the current language is the light pill. */
  .title__languages {
    position: absolute;
    top: 4.5rem;
    right: var(--pad-x);
    z-index: 1;
    display: flex;
    padding: 0.5rem;
    border-radius: 10rem;
    background: var(--fg);
  }

  .title__languages a {
    display: grid;
    place-items: center;
    min-width: max(6.4rem, 30px);
    min-height: max(4.4rem, 24px);
    border-radius: 10rem;
    color: var(--accent);
    text-decoration: none;
  }

  .title__languages a[aria-current] {
    background: var(--accent);
    color: var(--fg);
  }

  /* The tram scene: two lines, stops, trams and passengers. The script adds trams and passengers. */
  .scene {
    position: absolute;
    inset: 0;
    font-size: 1rem;
    pointer-events: none;
  }

  .scene[data-scene='flow'] {
    display: none;
  }

  .scene :global(svg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* The script draws its own stop markers, which it can hide under a tram. */
  .scene:global(.is-built) :global(circle) {
    display: none;
  }

  .scene :global(.scene__stop) {
    position: absolute;
    width: 4.5em;
    height: 4.5em;
    margin: -2.25em 0 0 -2.25em;
    border: 0.7em solid var(--fg);
    border-radius: 50%;
    background: var(--accent);
  }

  .scene :global(.scene__stop.is-hub) {
    width: 5.7em;
    height: 5.7em;
    margin: -2.85em 0 0 -2.85em;
  }

  .scene :global(.scene__car) {
    position: absolute;
    top: 0;
    left: 0;
    display: flex;
    gap: 0.6em;
    align-items: center;
    justify-content: center;
    width: 8.6em;
    height: 3em;
    margin: -1.5em 0 0 -4.3em;
    border-radius: 1.2em;
    visibility: hidden;
  }

  .scene :global(.scene__car.is-ready) {
    visibility: visible;
  }

  .scene :global(.scene__car[data-tone='light']) {
    background: var(--fg);
    color: var(--accent);
  }

  .scene :global(.scene__car[data-tone='dark']) {
    background: var(--accent);
    color: var(--fg);
  }

  /* Passengers at a stop: the first row is the one nearest to the line and fills from the left. */
  .scene :global(.scene__wait) {
    position: absolute;
    display: flex;
    flex-wrap: wrap-reverse;
    gap: 0.4em;
    width: 5em;
    margin: -1.6em 0 0 -2.5em;
    color: var(--fg);
  }

  .scene :global(i) {
    width: 1em;
    height: 1em;
    border-radius: 50%;
    background: currentColor;
    opacity: 0;
  }

  .scene :global(.scene__wait i) {
    width: 1.4em;
    height: 1.4em;
  }

  @media (--flow) {
    .title {
      padding-top: 8rem;
    }

    .title__languages {
      position: static;
      align-self: flex-end;
    }

    .title__slogan {
      margin-top: 0;
    }

    .title__manual {
      margin-top: 0;
      padding: 2.6rem 4.6rem 2.6rem 3.8rem;
    }

    .title__manual :global(svg) {
      width: 5.2rem;
      height: 5.2rem;
    }

    .scene[data-scene='stage'] {
      display: none;
    }

    /* The scene comes first in the page and last in the column. */
    .scene[data-scene='flow'] {
      position: relative;
      inset: auto;
      display: block;
      flex: none;
      order: 1;
      width: 108em;
      height: 52em;
      margin: auto calc(var(--pad-x) * -1) 0;
    }
  }
</style>
