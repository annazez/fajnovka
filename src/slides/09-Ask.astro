---
import Headline from '../components/Headline.astro';
import Slide from '../components/Slide.astro';
import { useDictionary } from '../i18n/index.ts';
import { toLocale } from '../i18n/locales.ts';

const t = useDictionary(toLocale(Astro.currentLocale)).ask;

// Timeline on a 1680 × 300 grid (1 unit = 0.1rem): four stops, then three possible decisions.
const lineY = 170;
const stopX = [40, 440, 840, 1240];
const decisionY = [30, 100, lineY];
---

<Slide id="ask" theme="navy" notes={t.notes} {...Astro.props}>
  <Headline id="ask-title" lines={t.title} />
  <p class="ask__lead t-body" data-in="2">
    {t.lead}
  </p>

  <div class="ask__timeline">
    <svg viewBox="0 0 1680 300" aria-hidden="true">
      <path class="ask__line" d={`M40 ${lineY}H1240`} pathLength="1"></path>
      {decisionY.map((y) => (
        <path class="ask__branch" d={`M1240 ${lineY}C1350 ${lineY} 1340 ${y} 1450 ${y}H1490`} pathLength="1" />
      ))}
      {stopX.map((x) => (
        <circle class="ask__stop" cx={x} cy={lineY} r="17" />
      ))}
      {decisionY.map((y) => (
        <circle class="ask__stop ask__stop--end" cx="1490" cy={y} r="13" />
      ))}
    </svg>

    <ol class="ask__steps stops-list t-body">
      {t.steps.map(({ when, what }, index) => (
        <li data-in={index * 2 + 5}>
          <strong>{when}</strong>
          <br />
          {what}
        </li>
      ))}
    </ol>

    <ul class="ask__decisions t-body">
      {t.decisions.map((decision, index) => (
        <li data-in={index + 15}>
          <strong>{decision}</strong>
        </li>
      ))}
    </ul>
  </div>
</Slide>

<style>
  @import '../styles/media.css';

  .ask__lead {
    margin-top: 3.6rem;
  }

  .ask__timeline {
    position: relative;
    width: 168rem;
    height: 30rem;
    margin: auto 0;
  }

  .ask__timeline svg {
    position: absolute;
    inset: 0;
  }

  .ask__line,
  .ask__branch {
    fill: none;
    stroke: var(--accent);
    stroke-width: 12;
    stroke-linecap: round;
  }

  .ask__stop {
    fill: var(--bg);
    stroke: var(--fg);
    stroke-width: 7;
  }

  .ask__stop--end {
    fill: var(--fg);
  }

  /* The line draws itself, the stops appear, then the three branches open. */
  :global(.deck.is-live) .ask__line,
  :global(.deck.is-live) .ask__branch {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }

  :global(.deck.is-live) .ask.is-active .ask__line {
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 1.6s var(--ease) 0.6s;
  }

  :global(.deck.is-live) .ask.is-active .ask__branch {
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 0.8s var(--ease) 2s;
  }

  :global(.deck.is-live) .ask__stop {
    transform: scale(0);
    transform-box: fill-box;
    transform-origin: center;
  }

  :global(.deck.is-live) .ask.is-active .ask__stop {
    transform: none;
    transition: transform 0.6s var(--spring) 0.7s;
  }

  :global(.deck.is-live) .ask.is-active .ask__stop:nth-of-type(2) {
    transition-delay: 1s;
  }

  :global(.deck.is-live) .ask.is-active .ask__stop:nth-of-type(3) {
    transition-delay: 1.3s;
  }

  :global(.deck.is-live) .ask.is-active .ask__stop:nth-of-type(4) {
    transition-delay: 1.6s;
  }

  :global(.deck.is-live) .ask.is-active .ask__stop--end {
    transition-delay: 2.5s;
  }

  /* Each step starts at its stop: the stops are 40rem apart, the first one is at 4rem. */
  .ask__steps {
    position: absolute;
    top: 20.6rem;
    left: 4rem;
    display: grid;
    grid-template-columns: repeat(4, 40rem);
  }

  .ask__decisions {
    position: absolute;
    top: -0.5rem;
    left: 153rem;
    display: grid;
    grid-template-rows: repeat(3, 7rem);
    align-items: center;
  }

  @media (--flow) {
    .ask__lead {
      margin-top: 0;
    }

    .ask__timeline {
      width: auto;
      height: auto;
      margin: 0;
    }

    .ask__timeline svg {
      display: none;
    }

    .ask__steps {
      position: relative;
      inset: auto;
      grid-template-columns: 1fr;
    }

    .ask__decisions {
      position: static;
      display: flex;
      flex-wrap: wrap;
      gap: 2.4rem;
      margin-top: 7rem;
    }

    .ask__decisions li {
      padding: 1.6rem 3.6rem;
      border: var(--line) solid var(--accent);
      border-radius: 10rem;
    }
  }
</style>
