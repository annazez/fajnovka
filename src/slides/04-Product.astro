---
import Icon from '../components/Icon.astro';
import Slide from '../components/Slide.astro';
import Wordmark from '../components/Wordmark.astro';

const pillars = [
  { icon: 'medal', text: 'Plakety za věrnost' },
  { icon: 'back', text: 'Cesta zpět místo pádu' },
  { icon: 'star', text: 'Fajnbody za změnu' },
  { icon: 'gift', text: 'Zážitky ve městě za polovinu' },
] as const;

// The mock card shows 430 of 500 points; the ring has radius 50.
const ring = 2 * Math.PI * 50;
const ringGap = ring * (1 - 430 / 500);
---

<Slide
  theme="white"
  class="product"
  notes="Fajnovka je věrnostní program města na kartě, kterou už máte, na ODISce. Kdo zůstává, dostává plaketu jako dárce krve. Kdo odchází, nespadne hned a má cestu zpět. Kdo mění zvyk, sbírá fajnbody. A ty mění za zážitky ve městě za polovinu."
>
  <div class="product__text">
    <h2 class="t-title" data-in>Věrnostní program města na kartě, <span class="mark">kterou už máte.</span></h2>
    <ul class="product__pillars t-body">
      {
        pillars.map(({ icon, text }, index) => (
          <li data-in style={`--i:${index * 2 + 4}`}>
            <Icon name={icon} />
            {text}
          </li>
        ))
      }
    </ul>
  </div>

  <div class="product__stage" data-in style="--i:3">
    <div class="card" data-theme="cyan" data-tilt>
      <div class="card__mark"><Wordmark /></div>
      <p class="card__draft t-small">návrh</p>

      <div class="card__account">
        <svg viewBox="0 0 120 120" aria-hidden="true">
          <circle class="card__track" cx="60" cy="60" r="50"></circle>
          <circle class="card__ring" cx="60" cy="60" r="50" style={`--ring:${ring};--gap:${ringGap}`}></circle>
        </svg>
        <p class="t-small"><b>430</b>fajnbodů<br />Diamantová plaketa</p>
      </div>

      <svg class="card__line" viewBox="0 0 720 100" aria-hidden="true">
        <path d="M-10 70H250q32 0 54-22t54-22H730"></path>
        <circle cx="130" cy="70" r="10"></circle>
        <circle cx="450" cy="26" r="10"></circle>
        <circle cx="620" cy="26" r="10"></circle>
      </svg>
    </div>
  </div>
</Slide>

<script>
  // The card leans towards the pointer; without a pointer it floats on its own.
  const slide = document.querySelector<HTMLElement>('.product');
  const card = slide?.querySelector<HTMLElement>('[data-tilt]');

  if (slide && card) {
    slide.addEventListener('pointermove', (event) => {
      const box = card.getBoundingClientRect();
      const x = (event.clientX - (box.left + box.width / 2)) / box.width;
      const y = (event.clientY - (box.top + box.height / 2)) / box.height;
      card.style.setProperty('--tilt-x', `${(-y * 16).toFixed(1)}deg`);
      card.style.setProperty('--tilt-y', `${(x * 20).toFixed(1)}deg`);
      card.style.setProperty('--shine', `${(50 + x * 60).toFixed(0)}%`);
    });

    slide.addEventListener('pointerleave', () => {
      card.style.removeProperty('--tilt-x');
      card.style.removeProperty('--tilt-y');
      card.style.removeProperty('--shine');
    });
  }
</script>

<style>
  .product {
    flex-direction: row;
    gap: 7rem;
    align-items: center;
  }

  .product__text {
    width: 92rem;
  }

  .product__pillars {
    display: grid;
    gap: 2.8rem;
    margin-top: 6.5rem;
  }

  .product__pillars li {
    display: flex;
    gap: 2.6rem;
    align-items: center;
  }

  .product__pillars :global(.icon) {
    flex: none;
    width: 7.2rem;
    height: 7.2rem;
  }

  .product__stage {
    flex: 1;
    perspective: 160rem;
  }

  .card {
    position: relative;
    aspect-ratio: 1.585;
    overflow: hidden;
    border-radius: 3.8rem;
    background:
      linear-gradient(105deg, transparent 30%, color-mix(in srgb, var(--accent) 26%, transparent) var(--shine, 46%), transparent 62%),
      var(--bg);
    box-shadow: 0 6rem 9rem -3rem var(--shadow);
    color: var(--fg);
    transform: rotateX(var(--tilt-x, 8deg)) rotateY(var(--tilt-y, -16deg)) rotateZ(-3deg);
    transition: transform 0.6s var(--ease);
    animation: card-float 6s ease-in-out infinite;

    --wm-word: var(--fg);
  }

  @keyframes card-float {
    50% {
      translate: 0 -1.8rem;
    }
  }

  .card__mark {
    position: absolute;
    top: 4.6rem;
    left: 4.6rem;
    width: 40rem;
  }

  .card__draft {
    position: absolute;
    top: 4.6rem;
    right: 4.6rem;
    opacity: 0.7;
  }

  .card__account {
    position: absolute;
    top: 13.2rem;
    left: 4.6rem;
    display: flex;
    gap: 2.8rem;
    align-items: center;
    font-weight: 800;
  }

  .card__account svg {
    width: 14rem;
    height: 14rem;
    transform: rotate(-90deg);
  }

  .card__account circle {
    fill: none;
    stroke-width: 13;
  }

  .card__track {
    stroke: var(--soft);
  }

  .card__ring {
    stroke: var(--accent);
    stroke-linecap: round;
    stroke-dasharray: var(--ring);
    stroke-dashoffset: var(--ring);
  }

  .product.is-active .card__ring {
    stroke-dashoffset: var(--gap);
    transition: stroke-dashoffset 1.6s var(--ease) 1.1s;
  }

  .card__account b {
    display: block;
    margin-bottom: 0.4rem;
    color: var(--accent);
    font-size: 8.8rem;
    font-weight: 900;
    line-height: 0.95;
    letter-spacing: -0.03em;
  }

  .card__line {
    position: absolute;
    right: 0;
    bottom: 2.4rem;
    left: 0;
  }

  .card__line path {
    fill: none;
    stroke: var(--accent);
    stroke-width: 9;
  }

  .card__line circle {
    fill: var(--accent);
    stroke: var(--fg);
    stroke-width: 4;
  }
</style>
