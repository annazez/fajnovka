---
import Headline from '../components/Headline.astro';
import Icon from '../components/Icon.astro';
import Slide from '../components/Slide.astro';
import Wordmark from '../components/Wordmark.astro';
import { numbers } from '../data/numbers.ts';
import { useDictionary } from '../i18n/index.ts';
import { toLocale } from '../i18n/locales.ts';
import { formatNumber } from '../lib/format.ts';

const locale = toLocale(Astro.currentLocale);
const t = useDictionary(locale).product;

const points = [
  { icon: 'levels', text: t.points.levels },
  { icon: 'points', text: t.points.rewards },
  { icon: 'discount', text: t.points.discounts },
  { icon: 'resume', text: t.points.resume },
] as const;

// The ring on the card shows the way to the next level: 86 % of it is done.
const RING_PROGRESS = 86;
---

<Slide id="product" theme="white" notes={t.notes} {...Astro.props}>
  <Headline id="product-title" lines={t.title} />

  <div class="product__row">
    <ul class="product__points t-body">
      {points.map(({ icon, text }, index) => (
        <li data-in={index * 2 + 4}>
          <Icon name={icon} />
          {text}
        </li>
      ))}
    </ul>

    <div class="product__stage" data-in="3" aria-hidden="true">
      <div class="card" data-theme="navy" data-tilt>
        <div class="card__mark">
          <Wordmark />
        </div>
        <div class="card__account">
          <svg viewBox="0 0 120 120">
            <circle class="card__track" cx="60" cy="60" r="50"></circle>
            <circle
              class="card__ring"
              cx="60"
              cy="60"
              r="50"
              pathLength="100"
              stroke-dasharray={`${RING_PROGRESS} 1000`}
            ></circle>
          </svg>
          <p class="card__text">
            <b>{formatNumber(numbers.cardPoints.value, locale)}</b>
            {t.card.points}
            <br />
            {t.card.level}
          </p>
        </div>
        <svg class="card__line" viewBox="0 0 720 100">
          <path d="M-10 70H250q32 0 54-22t54-22H730"></path>
          <circle cx="130" cy="70" r="10"></circle>
          <circle cx="450" cy="26" r="10"></circle>
          <circle cx="620" cy="26" r="10"></circle>
        </svg>
      </div>
    </div>
  </div>
</Slide>

<script>
  // The card leans towards the pointer. Without a pointer it keeps its resting angle.
  const slide = document.getElementById('product');
  const card = slide?.querySelector<HTMLElement>('[data-tilt]');

  if (slide && card) {
    slide.addEventListener('pointermove', (event) => {
      if (event.pointerType !== 'mouse') return;
      const box = card.getBoundingClientRect();
      const x = (event.clientX - (box.left + box.width / 2)) / box.width;
      const y = (event.clientY - (box.top + box.height / 2)) / box.height;
      card.style.setProperty('--tilt-x', `${(-y * 16).toFixed(1)}deg`);
      card.style.setProperty('--tilt-y', `${(x * 20).toFixed(1)}deg`);
      card.style.setProperty('--shine', `${(50 + x * 60).toFixed(0)}%`);
    });

    slide.addEventListener('pointerleave', () => {
      card.style.removeProperty('--tilt-x');
      card.style.removeProperty('--tilt-y');
      card.style.removeProperty('--shine');
    });
  }
</script>

<style>
  @import '../styles/media.css';

  .product__row {
    display: flex;
    flex: 1;
    gap: 8rem;
    align-items: center;
    margin-top: 2rem;
  }

  .product__points {
    display: grid;
    flex: 1;
    gap: 3.4rem;
  }

  .product__points li {
    display: flex;
    gap: 3rem;
    align-items: center;
  }

  .product__points :global(.icon) {
    flex: none;
    width: 7.6rem;
    height: 7.6rem;
  }

  .product__stage {
    flex: none;
    width: 66rem;
    perspective: 160rem;
  }

  /* The card is a mock-up. It scales as one piece: its sizes are in em. */
  .card {
    --wordmark-word: var(--fg);
    --wordmark-marks: var(--accent);

    position: relative;
    aspect-ratio: 1.585;
    overflow: hidden;
    border-radius: 3.8em;
    background:
      linear-gradient(
        105deg,
        transparent 30%,
        color-mix(in srgb, var(--fg) 14%, transparent) var(--shine, 46%),
        transparent 62%
      ),
      var(--bg);
    box-shadow: 0 6em 9em -3em var(--shadow);
    color: var(--fg);
    font-size: 1rem;
    transform: rotateX(var(--tilt-x, 8deg)) rotateY(var(--tilt-y, -16deg)) rotateZ(-3deg);
    transition: transform 0.6s var(--ease);
  }

  .card__mark {
    position: absolute;
    top: 4.6em;
    left: 4.6em;
    width: 40em;
  }

  .card__account {
    position: absolute;
    top: 13.2em;
    left: 4.6em;
    display: flex;
    gap: 2.8em;
    align-items: center;
  }

  .card__account svg {
    width: 14em;
    height: 14em;
    transform: rotate(-90deg);
  }

  .card__account circle {
    fill: none;
    stroke-width: 13;
  }

  .card__track {
    stroke: var(--soft);
  }

  .card__ring {
    stroke: var(--accent);
    stroke-linecap: round;
  }

  :global(.deck.is-live) .card__ring {
    stroke-dashoffset: 100;
  }

  :global(.deck.is-live) .product.is-active .card__ring {
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 1.6s var(--ease) 1.1s;
  }

  /* Text of the mock-up: it has its own sizes, as a real card has. */
  .card__text {
    font-size: 2.6em;
    font-weight: 700;
    line-height: 1.3;
  }

  .card__text b {
    display: block;
    margin-bottom: 0.05em;
    font-size: 3.4em;
    font-weight: 900;
    line-height: 0.95;
    letter-spacing: -0.03em;
  }

  .card__line {
    position: absolute;
    right: 0;
    bottom: 2.4em;
    left: 0;
  }

  .card__line path {
    fill: none;
    stroke: var(--accent);
    stroke-width: 9;
  }

  .card__line circle {
    fill: var(--bg);
    stroke: var(--fg);
    stroke-width: 4;
  }

  @media (--flow) {
    .product__row {
      flex-direction: column-reverse;
      gap: 8rem;
      align-items: stretch;
      margin: 0;
    }

    .product__points {
      gap: 4rem;
    }

    .product__points :global(.icon) {
      width: 9rem;
      height: 9rem;
    }

    .product__stage {
      width: auto;
      padding: 2rem 6rem 3rem;
    }

    .card {
      font-size: 1.21rem;
    }
  }
</style>
