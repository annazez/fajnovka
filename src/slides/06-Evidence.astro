---
import Headline from '../components/Headline.astro';
import Icon from '../components/Icon.astro';
import Slide from '../components/Slide.astro';
import { useDictionary } from '../i18n/index.ts';
import { toLocale } from '../i18n/locales.ts';

const t = useDictionary(toLocale(Astro.currentLocale)).evidence;

// Each item names a principle that the programme uses. An analogy is not a proof for Ostrava.
const evidence = [
  { icon: 'drop', ...t.items.donors },
  { icon: 'home', ...t.items.movers },
  { icon: 'levels', ...t.items.loyalty },
  { icon: 'card', ...t.items.odiska },
] as const;
---

<Slide id="evidence" theme="white" notes={t.notes} {...Astro.props}>
  <Headline id="evidence-title" lines={t.title} />

  <ul class="evidence__list">
    {evidence.map(({ icon, lead, text, source }, index) => (
      <li data-in={index * 3 + 3}>
        <Icon name={icon} />
        <p class="t-body">
          <strong>{lead}</strong> {text}
        </p>
        <p class="evidence__source t-small">{source}</p>
      </li>
    ))}
  </ul>
</Slide>

<style>
  @import '../styles/media.css';

  .evidence__list {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 5rem;
    margin-top: auto;
    margin-bottom: 3rem;
  }

  .evidence__list li {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    padding-top: 4.5rem;
    border-top: var(--line) solid var(--fg);
  }

  .evidence__list :global(.icon) {
    width: 10rem;
    height: 10rem;
  }

  .evidence__source {
    margin-top: auto;
    opacity: 0.75;
  }

  @media (--flow) {
    .evidence__list {
      grid-template-columns: 1fr;
      gap: 6rem;
      margin: 0;
    }

    .evidence__list li {
      display: grid;
      grid-template-columns: 11rem 1fr;
      gap: 2rem 4rem;
      padding-top: 5rem;
    }

    .evidence__list :global(.icon) {
      grid-row: span 2;
      width: 11rem;
      height: 11rem;
    }
  }
</style>
