---
import Icon from '../components/Icon.astro';
import Slide from '../components/Slide.astro';
import { cs, numbers } from '../data/numbers';

const packageItems = [
  { icon: 'ticket', text: 'Roční jízdenka' },
  { icon: 'star', text: `${cs(numbers.familyPackagePoints)} fajnbodů` },
  { icon: 'family', text: 'Rodinný účet' },
] as const;
---

<Slide
  theme="navy"
  class="family"
  notes="Novákovi mají dvě auta a dceru, která jde v září do první třídy. Dcera dostane první ODISku, rodina společný účet a první zážitek za polovinu. A když druhé auto čeká drahá oprava, je tu balíček O auto méně. Druhé auto, nebo rodinná sezona v ZOO?"
>
  <h2 class="t-title" data-in>Druhé auto, nebo<br /><span class="mark">rodinná sezona v&nbsp;ZOO?</span></h2>

  <div class="family__row">
    <div class="family__tile" data-in style="--i:3"><Icon name="car" /></div>

    <div class="family__swap" data-in style="--i:5">
      <button class="family__flip" type="button" data-flip aria-label="Druhé auto, nebo balíček O auto méně">
        <span class="family__face"><Icon name="car" /></span>
        <span class="family__face family__face--back t-body" data-theme="cyan">
          {
            packageItems.map(({ icon, text }) => (
              <span>
                <Icon name={icon} />
                {text}
              </span>
            ))
          }
        </span>
      </button>
    </div>

    <p class="family__text t-body" data-in style="--i:8">
      Prvňáček dnes dostává první ODISku zdarma. Rodině, která se vzdá druhého auta, k&nbsp;ní nabídneme balíček <strong>O&nbsp;auto&nbsp;méně</strong>.
    </p>
  </div>

  <p class="slide__foot t-small">Návrh nabídky, partnery odměn potvrdí pilot · Moje první ODISka, KODIS 2026</p>
</Slide>

<script>
  // The second car turns into the family package shortly after the slide opens; a click turns it back.
  const slide = document.querySelector<HTMLElement>('.family');
  const flip = slide?.querySelector<HTMLElement>('[data-flip]');
  let timer = 0;

  if (slide && flip) {
    slide.addEventListener('slide:enter', () => {
      timer = window.setTimeout(() => flip.classList.add('is-flipped'), 2200);
    });

    slide.addEventListener('slide:leave', () => {
      clearTimeout(timer);
      flip.classList.remove('is-flipped');
    });

    flip.addEventListener('click', () => {
      clearTimeout(timer);
      flip.classList.toggle('is-flipped');
    });
  }
</script>

<style>
  .family__row {
    display: flex;
    gap: 4rem;
    align-items: center;
    margin-top: auto;
    margin-bottom: 3rem;
  }

  .family__tile,
  .family__swap {
    flex: none;
    width: 50rem;
    height: 38rem;
  }

  .family__tile,
  .family__face {
    padding: 7rem;
    border: 0.7rem solid var(--fg);
    border-radius: 3.4rem;
  }

  .family__swap {
    perspective: 140rem;
  }

  .family__flip {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    transition: transform 1s var(--ease);
  }

  .family__flip.is-flipped {
    transform: rotateY(180deg);
  }

  .family__face {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
  }

  .family__face--back {
    display: flex;
    flex-direction: column;
    gap: 2.8rem;
    justify-content: center;
    padding: 4rem 4.4rem;
    border-color: var(--bg);
    background: var(--bg);
    color: var(--fg);
    text-align: left;
    transform: rotateY(180deg);
  }

  .family__face--back span {
    display: flex;
    gap: 1.8rem;
    align-items: center;
    font-weight: 800;
  }

  .family__face--back :global(.icon) {
    flex: none;
    width: 7.2rem;
    height: 7.2rem;
  }

  .family__text {
    margin-left: 3rem;
  }
</style>
